{
  "name": "java-security-feedback",
  "displayName": "Java Security Feedback",
  "description": "Developer-focused security feedback for Java",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "java-security-feedback.runAnalysis",
        "title": "Java Security Feedback: Run Security Analysis"
      },
      {
        "command": "java-security-feedback.setGeminiApiKey",
        "title": "Java Security Feedback: Set Gemini API Key"
      },
      {
        "command": "java-security-feedback.removeGeminiApiKey",
        "title": "Java Security Feedback: Remove Gemini API Key"
      }
    ],
    "configuration": {
      "title": "Java Security Feedback",
      "properties": {
        "java-security-feedback.codeqlPath": {
          "type": "string",
          "default": "codeql",
          "description": "Path to the CodeQL CLI executable. Use 'codeql' if it is available on your system PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
